# Environment defaults for the compiled client.  nuitka_build.py copies this
# into the release as config/release.env; client_main.py reads it at start.
# A value already set in the environment (by a launcher or the player) wins.
#
# These are the variables darwin/start_game.command and win32/start_dev.bat
# set by hand.  POC_TOKEN (the play token) is deliberately not here: a
# launcher passes it, or the player gives --token.

# Game server (client agent).  This is PRODUCTION_SERVER from
# config/environ/default.env; check it before a release.
POC_GAMESERVER=142.44.142.241

GAME_ENVIRONMENT=LIVE
GAME_SHOW_ADDS=YES
GAME_INGAME_UPGRADE=https://www.piratesclassic.online/
GAME_INGAME_MOREINFO=https://www.piratesclassic.online/about
GAME_INGAME_NAMING=https://www.piratesclassic.online/help/nameapprovals
GAME_INGAME_MANAGE_ACCT=https://www.piratesclassic.online/account
